# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/dist
/.wrangler
/.wrangler-build
/.npm-cache

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment secrets; the documented template is safe to commit
.env*
!.env.example

# typescript
*.tsbuildinfo

# Worker local secrets
.dev.vars
!.dev.vars.example
