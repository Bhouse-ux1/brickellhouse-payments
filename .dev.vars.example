# Copy to .dev.vars only for local Worker development. Never commit real values.
ENVIRONMENT=development

# Production Better Auth. Use a unique random secret of at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret
BETTER_AUTH_URL=https://brickellhouse-payments.assistantmanager.workers.dev

# Local-only one-time initial administrator bootstrap input.
INITIAL_ADMIN_EMAIL=

# Optional local PostgreSQL connection. Production uses the HYPERDRIVE binding.
DATABASE_URL=

# Physical Stripe S710 — LIVE MODE ONLY. Store production values as Cloudflare secrets.
STRIPE_SECRET_KEY=rk_live_replace_me
STRIPE_TERMINAL_READER_ID=tmr_replace_me
STRIPE_TERMINAL_LOCATION_ID=tml_replace_me
STRIPE_TERMINAL_WEBHOOK_SECRET=whsec_replace_me
STRIPE_LIVE_MODE_ONLY=true

# Resend server-side delivery. EMAIL_FROM must belong to a verified Resend domain.
RESEND_API_KEY=
EMAIL_FROM=
