# Copy to .dev.vars only for local Worker development. Never commit real values.
ENVIRONMENT=development

# Temporary controlled access. Replace with final employee authentication before production use.
TEST_ACCESS_PASSWORD=replace-with-a-strong-temporary-password
TEST_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional local PostgreSQL connection. Production uses the HYPERDRIVE binding.
DATABASE_URL=

# Physical Stripe S710 — LIVE MODE ONLY. Store production values as Cloudflare secrets.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_TERMINAL_READER_ID=tmr_replace_me
STRIPE_TERMINAL_LOCATION_ID=tml_replace_me
STRIPE_TERMINAL_WEBHOOK_SECRET=whsec_replace_me
STRIPE_LIVE_MODE_ONLY=true

# Receipt delivery is intentionally not configured in this phase.
RESEND_API_KEY=
EMAIL_FROM=
